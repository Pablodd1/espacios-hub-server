# ===== SIIGO (create app at https://developer.siigo.com - free sandbox) =====
SIIGO_USERNAME=siigoapi@yourcompany.com
SIIGO_ACCESS_KEY=your_siigo_access_key
SIIGO_PARTNER_ID=EspaciosHub
SIIGO_SANDBOX=true

# ===== Supabase (project Settings > API) =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# ===== Sync engine =====
SYNC_INTERVAL_MIN=15
PORT=3100
WEBHOOK_SECRET=change_me

# ===== Bank mapping: SIIGO account name -> HGI ledger account =====
BANK_MAP_JSON={"Diseno":"11050501","Agil Nomina":"11100501","Espacios":"11100502"}
